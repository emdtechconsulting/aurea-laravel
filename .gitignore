# Configuraciones privadas; conservar la plantilla de instalación
.env.*
!.env.example

# Bases de datos locales y archivos auxiliares de SQLite
/database/*.sqlite*
/database/*.db*

# Archivos generados durante la ejecución
/bootstrap/cache/*.php
/storage/framework/cache/**
/storage/framework/sessions/**
/storage/framework/views/**
/storage/framework/testing/**
/storage/logs/**

# Bloqueo del actualizador
/.aurea-update.lock

# Conservar la estructura de carpetas de Laravel
!/storage/framework/cache/**/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/framework/testing/.gitignore
!/storage/logs/.gitignore
